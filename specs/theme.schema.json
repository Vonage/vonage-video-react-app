{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonage.com/schemas/v1/video-app-theme.schema.json",
  "title": "Vonage Video App Theme Tokens",
  "description": "Unified design-token schema shared by the Android, iOS and React Vonage Video apps.",
  "version": "1.0.0",
  "type": "object",
  "required": ["metadata", "colors", "borderRadius", "typography"],
  "additionalProperties": false,
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "colors": {
      "type": "object",
      "required": ["light", "dark"],
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/$defs/colorSet" },
        "dark": { "$ref": "#/$defs/colorSet" }
      }
    },
    "borderRadius": {
      "type": "object",
      "required": ["none", "extra-small", "small", "medium", "large", "extra-large"],
      "additionalProperties": false,
      "properties": {
        "none": { "type": "number", "minimum": 0 },
        "extra-small": { "type": "number", "minimum": 0 },
        "small": { "type": "number", "minimum": 0 },
        "medium": { "type": "number", "minimum": 0 },
        "large": { "type": "number", "minimum": 0 },
        "extra-large": { "type": "number", "minimum": 0 }
      }
    },
    "typography": {
      "type": "object",
      "required": ["font-family", "desktop", "mobile"],
      "additionalProperties": false,
      "properties": {
        "font-family": { "type": "string", "minLength": 1 },
        "desktop": { "$ref": "#/$defs/typographyScale" },
        "mobile": { "$ref": "#/$defs/typographyScale" }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name", "version", "created", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "created": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "semver": {
      "type": "string",
      "description": "Semantic version (MAJOR.MINOR.PATCH) of the theme document, matching the schema version it targets.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "color": {
      "type": "string",
      "description": "6- or 8-digit hex colour (8-digit allows an alpha channel).",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "colorSet": {
      "type": "object",
      "description": "A color palette for one appearance. Core keys are required; extra semantic colors are allowed but must be valid hex.",
      "required": [
        "primary", "text-primary", "on-primary", "primary-hover",
        "secondary", "text-secondary", "on-secondary",
        "tertiary", "text-tertiary", "on-tertiary",
        "background", "on-background",
        "surface", "on-surface",
        "error", "on-error", "error-hover",
        "warning", "on-warning", "warning-hover",
        "success", "on-success", "success-hover",
        "border", "disabled", "text-disabled"
      ],
      "additionalProperties": { "$ref": "#/$defs/color" }
    },
    "typographyStyle": {
      "type": "object",
      "required": ["font-size", "line-height", "font-weight"],
      "additionalProperties": false,
      "properties": {
        "font-size": { "type": "string", "pattern": "^\\d+px$" },
        "line-height": { "type": "string", "pattern": "^\\d+px$" },
        "font-weight": { "type": "integer", "minimum": 100, "maximum": 900 }
      }
    },
    "typographyScale": {
      "type": "object",
      "description": "The full set of named text styles for one viewport.",
      "required": [
        "headline", "subtitle",
        "heading-1", "heading-2", "heading-3", "heading-4",
        "body-extended", "body-extended-semibold",
        "body-base", "body-base-semibold",
        "caption", "caption-semibold"
      ],
      "additionalProperties": { "$ref": "#/$defs/typographyStyle" }
    }
  }
}
