#!/usr/bin/env sh
set -eu

# Skip on CI
[ -n "${CI:-}" ] && exit 0

# Load nvm if available (needed for yarn to be on PATH)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

echo "🔍 Running tests before push..."
yarn --silent test

echo "🔍 Verifying @vonage/video-common source hash..."
yarn nx run common:hash:check
