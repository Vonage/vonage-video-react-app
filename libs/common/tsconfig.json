{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": ["eslint.config.mjs", "./test/**/*", "web-test/**/*", "node-test/**/*"],
  "references": [{ "path": "./tsconfig.lib.json" }, { "path": "./tsconfig.spec.json" }],
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": "./",
    "moduleResolution": "node",
    "paths": {
      "@common": ["./src"],
      "@common/*": ["./src/*"],
      "@web": ["./web"],
      "@web/*": ["./web/*"],
      "@node": ["./node"],
      "@node/*": ["./node/*"],
      "@common-test": ["./test"],
      "@common-test/*": ["./test/*"],
      "@web-test": ["web-test"],
      "@web-test/*": ["web-test/*"],
      "@node-test": ["node-test"],
      "@node-test/*": ["node-test/*"]
    },
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  }
}
