{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "web-test/**/*.tsx",
    "web-test/**/*.ts",
    "node-test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.ts",
    "node/**/*.ts",
    "web/**/*.tsx",
    "web/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.ts"
  ],
  "exclude": ["**/*.spec.*", "**/*.test.*"]
}
