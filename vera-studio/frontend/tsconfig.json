{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@ui": ["../../libs/ui/src"],
      "@ui/*": ["../../libs/ui/src/*"],
      "@common": ["../../libs/common/src"],
      "@common/*": ["../../libs/common/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "build"]
}
