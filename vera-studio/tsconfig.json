{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@api-lib": ["../libs/api/src"],
      "@api-lib/*": ["../libs/api/src/*"],
      "@common": ["../libs/common/src"],
      "@common/*": ["../libs/common/src/*"],
      "@node": ["../libs/common/srcNode"],
      "@node/*": ["../libs/common/srcNode/*"],
      "@ui": ["../libs/ui/src"],
      "@ui/*": ["../libs/ui/src/*"]
    }
  }
}
