# Get your Vonage Application ID and Private Key here: https://dashboard.nexmo.com/
# If using OpenTok SDK and credentials make sure to remove this block and uncomment the block below with OT_ variables.

VIDEO_SERVICE_PROVIDER='vonage'
VONAGE_APP_ID=''
# e.g. (this is an example application Id): 
# VONAGE_APP_ID='12d0d0-aaaa-bbb-ccc-26b780fb'
VONAGE_PRIVATE_KEY=''
# e.g.: (this is an example private key)
# VONAGE_PRIVATE_KEY='----BEGIN RSA PRIVATE KEY-----
# MIIBOAIBAAJARsF2wfXtjllRR8nnz8+CLULn0bqgZtYktJB2BdcB5bw6OYmmDVCc
# TeTC3VXZATdSqNA6WDWCkSVinC05uYEOEwIDAQABAkArUAaYmSkAeKCO54Pl7Ert
# 1gT+l9XU3cW+Wqhdfnsjkdjaksdjas9phpdiQXNosI60a8YyeyBUjCtQGFwbJ1Kl
# AiEAioOWu1s5nbB6ioOXdhbW4Ovfdkjnldfjlkndfjk/njsCIQCCxRfwRVfDcC0h
# hvuOpFzvZ870deo1/OD8j4U8jG+aCQIgXeU55qO+eODLEN6Ha+urmikc1kyQC/KP
# aKMjV5PzfUUCIdfgdfgdERJ1K9EVwfE/5bH1E+TERb3j21UZZphjGv15AiBBs0w5
# WRuPspPXIAHPKrjEHkUsgDZHW/V0fJWbIjJarw==6ISP6wuV0E6SRl1xKVyoYT0D
# 8iIsCNO9GfFOx3HWN7Q1++fAAhV37
# -----END PRIVATE KEY-----
# '

# If using OpenTok SDK (https://tokbox.com/developer/sdks/js/) remove the variables above and use these instead.
# VIDEO_SERVICE_PROVIDER='opentok'
# OT_API_KEY=api-key
# OT_API_SECRET=api-secret

# Secret used to sign and verify session key JWTs. Generate one with: yarn generate:secret
SESSION_KEY_SECRET=''

# Web origins allowed to call the backend from the browser with credentials: comma-separated exact
# origins (https://app.example.com), optionally with one * in the first host label
# (https://app-*.example.com). "*" allows any origin: local development only. Include the origin the
# app is served from when it differs from the backend's, and every page that embeds <vera-room>.
# Native apps don't send an Origin header and aren't affected.
CORS_ALLOWED_ORIGINS='*'

# If deploying to Vonage Cloud Runtime (https://developer.vonage.com/en/vonage-cloud-runtime/overview)
# enter your port here; the default is 3345.
# DO NOT SET THIS VARIABLE IN LOCAL ENV:
# If this variable is set the app will try to use VCR Storage.
# VCR_PORT=3345

# If implementing the jira service for customer feedback, enter your credentials here.
# JIRA_URL=jira-url
# JIRA_API_URL=jira-api-url
# JIRA_TOKEN=jira-token
# JIRA_PROJECT_KEY=jira-project-key
# JIRA_COMPONENT_ID=jira-component-id
# JIRA_EPIC_URL='jira-epic-url'
# JIRA_EPIC_LINK='jira-epic-link'
# JIRA_SEVERITY_ID='jira-severity-id'

# OIDC authentication, applied to every route except the exclusion list in server.ts.
# Off unless AUTH_ENABLED='true'. The values below point to the local provider (apps/local-oidc),
# which `yarn dev` starts on port 3346; replace them with your provider's to use another one.
# See docs/CONFIGURATION.md.
AUTH_ENABLED='true'

# Required when AUTH_ENABLED='true'. Endpoints are full URLs.
OIDC_CLIENT_ID='vera-local'
# Callback URL on this app where the provider sends the browser after login. Register it with the
# provider. Any path works: the backend mounts the callback route on this URL's path.
OIDC_WEB_REDIRECT_URI='http://localhost:5173/api/auth/callback/okta'
# Provider URL the browser is sent to for login.
OIDC_AUTHORIZATION_ENDPOINT='http://localhost:3346/authorize'
OIDC_TOKEN_ENDPOINT='http://localhost:3346/token'
OIDC_INTROSPECTION_ENDPOINT='http://localhost:3346/introspect'
# Encrypts the session cookies. Generate one per environment with: yarn generate:secret
AUTH_COOKIE_SECRET=''

# Sign-out, required when AUTH_ENABLED='true'. Sign-out revokes the tokens, clears the session
# cookies, then sends the browser to the provider to end its login session.
# Provider API the backend calls to revoke the access and refresh tokens.
OIDC_REVOCATION_ENDPOINT='http://localhost:3346/revoke'
# Provider URL that ends the provider's login session.
OIDC_END_SESSION_ENDPOINT='http://localhost:3346/logout'
# Where the provider sends the browser back after end-session. Register it with the provider.
OIDC_POST_LOGOUT_REDIRECT_URI='http://localhost:5173/'

# Project-level auth settings. env.defaults.sh sets the values shown; uncomment one to override it.
# Cookie holding the encrypted access and refresh tokens.
# AUTH_SESSION_COOKIE_NAME='vera-session'
# Cookie holding the encrypted ID token, sent only to the sign-out route.
# AUTH_ID_TOKEN_COOKIE_NAME='vera-id-token'
# Short-lived cookie holding the login state and PKCE verifier between sign-in and the callback.
# AUTH_TRANSACTION_COOKIE_NAME='vera-sign-in'
# How long the user has to finish logging in at the provider.
# AUTH_TRANSACTION_MAX_AGE_SECONDS=600
# Refresh the access token when it has this many seconds left.
# AUTH_REFRESH_WINDOW_SECONDS=30
# Timeout for every call to the provider (token, introspection, revocation).
# AUTH_PROVIDER_TIMEOUT_MS=5000
# Scopes requested at sign-in. offline_access asks for a refresh token.
# OIDC_SCOPES='openid profile email offline_access'
# Request header and scheme that carry a Bearer token (mobile clients).
# AUTH_HEADER_NAME='authorization'
# AUTH_SCHEME='Bearer'
