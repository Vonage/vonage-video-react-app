{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser", "chrome", "--isolated"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "nx": {
      "type": "stdio",
      "command": "npx",
      "cwd": "${workspaceFolder}",
      "args": [
        "-y",
        "nx-mcp@latest",
        "--no-minimal",
        "--disableTelemetry",
        "--tools",
        "nx_workspace",
        "nx_workspace_path",
        "nx_project_details",
        "nx_docs",
        "nx_generators",
        "nx_generator_schema",
        "nx_current_running_tasks_details",
        "nx_current_running_task_output"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "codegraphcontext": {
      "type": "stdio",
      "command": "/Users/jquesadachaves/.venvs/codegraphcontext/bin/cgc",
      "cwd": "${workspaceFolder}",
      "args": ["mcp", "start"],
      "env": {
        "CGC_OUTPUT_FORMAT": "gcf"
      }
    }
  }
}
